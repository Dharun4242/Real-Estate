# ── Cashfree backend configuration ──────────────────────────────
# Copy this file to server/.env and paste your TEST credentials.
# Get them from: Cashfree Dashboard → Developers → API Keys

CASHFREE_MODE=sandbox
CASHFREE_CLIENT_ID=your_test_app_id_here
CASHFREE_CLIENT_SECRET=your_test_secret_key_here

# Port the API server listens on (frontend dev proxy expects 8080)
PORT=8080

# Public URL of your site (used to build Cashfree's return_url).
# Set this to your real domain in production, e.g. https://poesgarden.com
APP_URL=http://localhost:5173
