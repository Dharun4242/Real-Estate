# ── Frontend (Vite) configuration ───────────────────────────────
# Copy to .env  — only PUBLIC values belong here (they ship to the browser).
# Your Cashfree SECRET key must NEVER go here — it lives in server/.env.

# Cashfree checkout environment: sandbox | production
VITE_CASHFREE_MODE=sandbox

# Deployed payment backend URL. Leave blank for local dev (uses Vite proxy
# to http://localhost:8080). In production set it to your API host, e.g.
# https://real-estate-gj09.onrender.com
VITE_API_BASE_URL=
